            ] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "const task = body.result?.task;",
            "if (task?.id) pm.environment.set('taskId', task.id);",
            "if (task?.contextId) pm.environment.set('contextId', task.contextId);",
