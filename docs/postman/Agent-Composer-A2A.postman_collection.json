          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "A2A-Version", "value": "1.0" }],
            "body": { "mode": "raw", "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": \"{{$guid}}\",\n  \"method\": \"SendMessage\",\n  \"params\": {\n    \"message\": {\n      \"messageId\": \"{{$guid}}\",\n      \"role\": \"ROLE_USER\",\n      \"parts\": [{ \"text\": \"{{permissionTestMessage}}\" }]\n    }\n  }\n}" },
            "url": "{{baseUrl}}{{agentPath}}"
          }
        },
        {
          "name": "SendStreamingMessage - Start Streaming Permission Task",
